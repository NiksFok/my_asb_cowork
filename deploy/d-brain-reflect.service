[Unit]
Description=d-brain Weekly Reflection Finalizer
After=network.target

[Service]
Type=oneshot
User=niks
WorkingDirectory=/home/niks/my_asb
ExecStartPre=+/usr/bin/systemctl stop d-brain-bot
ExecStart=/home/niks/.local/bin/uv run python scripts/reflect_finalize.py
ExecStopPost=+/usr/bin/systemctl start d-brain-bot
EnvironmentFile=/home/niks/my_asb/.env
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
