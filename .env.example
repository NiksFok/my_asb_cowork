# === ОБЯЗАТЕЛЬНЫЕ ТОКЕНЫ ===

# Telegram Bot Token (от @BotFather)
TELEGRAM_BOT_TOKEN=

# Deepgram API Key (от console.deepgram.com, бесплатный кредит $200)
DEEPGRAM_API_KEY=

# === ОПЦИОНАЛЬНЫЕ ТОКЕНЫ ===

# Todoist API Token (todoist.com → Settings → Integrations → Developer)
TODOIST_API_KEY=

# YouTube Data API v3 Key (console.cloud.google.com)
YOUTUBE_API_KEY=

# Anthropic API Key (console.anthropic.com) — нужен только если Claude Code не авторизован
ANTHROPIC_API_KEY=

# Firecrawl API Key (firecrawl.dev) — для скрапинга веб-страниц
FIRECRAWL_API_KEY=

# Oura Ring Access Token (cloud.ouraring.com)
OURA_ACCESS_TOKEN=

# Supabase (app.supabase.com → Project Settings → API)
# URL вида: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# service_role key (не anon! нужны права на запись без RLS)
SUPABASE_KEY=

# === НАСТРОЙКИ ===

# Путь к Obsidian vault (не менять)
VAULT_PATH=./vault

# === ПОСТОЯННАЯ СЕССИЯ (ASB v3.0, биллинг по подписке) ===
# Бот держит одну долгоживущую ИНТЕРАКТИВНУЮ сессию Claude Code в tmux вместо
# headless `claude -p` (который с 15.06.2026 биллится отдельным Agent SDK-кредитом).

# Модель сессии. Пусто = дефолт Claude Code. Рекомендуется Opus 4.8 для качества.
# Варианты: claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-opus-4-8

# Модель учебной сессии («🎓 Учёба») — отдельная сессия-репетитор.
# Sonnet по умолчанию: заметно дешевле и не тратит квоту Opus основного мозга.
STUDY_MODEL=claude-sonnet-5

# Таймзона для таймеров/отчётов
TZ=Europe/Moscow

# Каталог рантайма сессии: pane.lock, pane.log, ready/inflight (ЛОКАЛЬНАЯ ФС!)
# По умолчанию ~/.dbrain — менять не нужно.
#RUNTIME_DIR=~/.dbrain

# Имя tmux-сессии (пусто = сгенерируется и сохранится при первом старте)
#BRAIN_SESSION_NAME=

# Telegram ID пользователя (бот отвечает только вам)
# Узнать свой ID: @userinfobot в Telegram
ALLOWED_USER_IDS=[123456789]

# Включить ночную авто-имплементацию улучшений (true/false)
NIGHT_IMPLEMENT_ENABLED=false

# Включить модуль здоровья Oura Ring (true/false)
# Требует OURA_ACCESS_TOKEN. По умолчанию выключен.
HEALTH_ENABLED=false

# Локация по умолчанию (обновляется командой /location)
LOCATION_CITY=Москва
LOCATION_LAT=55.75
LOCATION_LON=37.62
LOCATION_TZ=Europe/Moscow
